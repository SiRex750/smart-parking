@startuml
!include common.iuml
left to right direction
skinparam usecaseBackgroundColor #EAF2FB
skinparam usecaseBorderColor #2E74B5
actor Driver
actor "Payment Gateway" as PG <<external>>
rectangle "Smart Parking Management System" {
  usecase "View real-time availability" as UC1
  usecase "Reserve a slot" as UC2
  usecase "Cancel reservation" as UC3
  usecase "Check in with reservation" as UC4
  usecase "Enter parking lot" as UC5
  usecase "Auto-allocate suitable slot" as UC6
  usecase "Exit parking lot" as UC7
  usecase "Calculate parking fee" as UC8
  usecase "Pay parking fee" as UC9
  usecase "Get receipt" as UC10
}
Driver --> UC1
Driver --> UC2
Driver --> UC3
Driver --> UC4
Driver --> UC5
Driver --> UC7
Driver --> UC9
UC5 ..> UC6 : <<include>>
UC4 ..> UC5 : <<extend>>
UC7 ..> UC8 : <<include>>
UC9 ..> UC8 : <<include>>
UC10 ..> UC9 : <<extend>>
UC9 --> PG
@enduml
